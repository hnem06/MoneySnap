<?xml version="1.0" encoding="utf-8"?>
<!-- Dark palette: overrides the named colors used as backgrounds/ink across layouts.
     Colors used ON green surfaces (white, hero tints, primary_green) are not overridden. -->
<resources>
    <!-- Surfaces -->
    <color name="light_gray_bg">#0F1214</color>
    <color name="surface">#0F1214</color>
    <color name="card_bg">#1B1F24</color>
    <color name="icon_square_bg">#262B31</color>

    <!-- Ink -->
    <color name="on_surface">#E5E7EB</color>
    <color name="text_dark">#E5E7EB</color>
    <color name="text_muted">#9CA3AF</color>
    <color name="icon_neutral">#C5CAD1</color>

    <!-- Lines & tracks -->
    <color name="border_gray">#2A2E33</color>
    <color name="divider_color">#2A2E33</color>
    <color name="progress_track">#2A2E33</color>
    <color name="bar_inactive">#3A4046</color>

    <!-- Accents -->
    <color name="accent_green">#6EE7B7</color>
    <color name="soft_green">#14352B</color>

    <!-- Offline banner: dark amber surface with a light amber ink, keeping the same
         semantic while staying readable on the dark background. -->
    <color name="offline_banner_bg">#3A2E10</color>
    <color name="offline_banner_text">#FCD34D</color>
</resources>
