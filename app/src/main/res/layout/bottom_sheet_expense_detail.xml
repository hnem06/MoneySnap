<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingBottom="24dp">

    <!-- Drag handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_drag_handle" />

    <!-- Category chip -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:background="@drawable/bg_category_chip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp">

        <ImageView
            android:id="@+id/detailCategoryIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@string/cd_category"
            android:src="@drawable/ic_category_food"
            app:tint="#212121" />

        <TextView
            android:id="@+id/detailCategoryLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/category_food"
            android:textColor="#212121"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Amount -->
    <TextView
        android:id="@+id/detailAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="12dp"
        android:text=""
        android:textColor="@color/accent_green"
        android:textSize="36sp"
        android:textStyle="bold" />

    <!-- Title / Note -->
    <TextView
        android:id="@+id/detailTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="4dp"
        android:text=""
        android:textColor="#374151"
        android:textSize="16sp" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="20dp"
        android:background="#E5E7EB" />

    <!-- Detail rows container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:paddingHorizontal="24dp">

        <!-- Date & Time row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="12dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/cd_date"
                android:src="@drawable/ic_detail_calendar"
                app:tint="#6B7280" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/detail_date_time"
                android:textColor="#6B7280"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/detailDateTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#111827"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Payment Method row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="12dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/cd_payment"
                android:src="@drawable/ic_detail_payment"
                app:tint="#6B7280" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/detail_payment_method"
                android:textColor="#6B7280"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/detailPaymentMethod"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/detail_payment_cash"
                android:textColor="#111827"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Receipt Attached section -->
        <LinearLayout
            android:id="@+id/detailReceiptSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:visibility="gone">

            <!-- Label row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/cd_receipt"
                    android:src="@drawable/ic_detail_receipt"
                    app:tint="#6B7280" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/detail_receipt_attached"
                    android:textColor="#6B7280"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Receipt image preview -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/detailReceiptImage"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="10dp"
                android:contentDescription="@string/cd_receipt_photo"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Receipt" />
        </LinearLayout>
    </LinearLayout>

    <!--
        Sync state. Hidden for synced expenses, which are the overwhelming majority — surfacing
        it always would make normal saves look uncertain. ExpenseSyncStatus and
        ReceiptUploadStatus existed in the domain layer but were never shown anywhere, so a
        failed upload was completely invisible to the user.
    -->
    <LinearLayout
        android:id="@+id/detailSyncSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/detailSyncStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/text_muted"
            app:drawableStartCompat="@drawable/ic_cloud_off"
            app:drawableTint="@color/text_muted"
            tools:text="@string/sync_status_pending" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetrySync"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/sync_retry" />
    </LinearLayout>

    <!-- Bottom buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp">

        <!-- Delete button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDelete"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/detail_delete"
            android:textColor="@color/accent_green"
            app:cornerRadius="26dp"
            app:icon="@drawable/ic_detail_delete"
            app:iconGravity="textStart"
            app:iconSize="20dp"
            app:iconTint="@color/accent_green"
            app:strokeColor="#D1D5DB"
            app:strokeWidth="1dp" />

        <!-- Edit button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEdit"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1.5"
            android:backgroundTint="@color/accent_green"
            android:text="@string/detail_edit"
            android:textColor="@android:color/white"
            app:cornerRadius="26dp"
            app:icon="@drawable/ic_detail_edit"
            app:iconGravity="textStart"
            app:iconSize="20dp"
            app:iconTint="@android:color/white" />
    </LinearLayout>
</LinearLayout>
