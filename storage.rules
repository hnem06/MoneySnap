rules_version = '2';

// MoneySnap — ảnh hoá đơn, mỗi user chỉ đọc/ghi thư mục của mình.
// Đường dẫn app ghi: receipts/{userId}/{expenseId}.jpg
// Ảnh đã được nén xuống ~1280px / JPEG q85 (thường <1MB) trước khi upload,
// nên ngưỡng 5MB an toàn, không chặn nhầm ảnh camera.
service firebase.storage {
  match /b/{bucket}/o {
    // Account deletion enumerates this prefix to remove every receipt. `list` is granted on the
    // prefix itself, which the object-level rule below does not cover — without this, listAll()
    // fails and deleting an account silently orphans all of its images.
    match /receipts/{userId} {
      allow list: if request.auth != null && request.auth.uid == userId;
    }

    match /receipts/{userId}/{fileName} {
      allow read, delete: if request.auth != null
                          && request.auth.uid == userId;

      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && request.resource.size < 5 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');
    }

    // Ảnh đại diện: avatars/{userId}/avatar.jpg — chỉ chủ tài khoản đọc/ghi/xóa.
    match /avatars/{userId}/{fileName} {
      allow read, delete: if request.auth != null
                          && request.auth.uid == userId;

      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && request.resource.size < 5 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');
    }

    // Chặn mọi đường dẫn khác.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
